participants = {}  # Храним участников: имя -> {info, wins, losses, points}

def add_participant(name, info):
    """Регистрирует участника и возвращает его данные."""
    if name in participants:
        print(f"Ошибка: участник '{name}' уже зарегистрирован.")
        return None
    
    participants[name] = {
        'info': info,
        'wins': 0,
        'losses': 0,
        'points': 0
    }
    print(f"Участник '{name}' успешно зарегистрирован.")
    return participants[name]

def create_match(player1, player2):
    """Проверяет возможность матча. Возвращает True, если всё в порядке, иначе False."""
    if player1 not in participants:
        print(f"Ошибка: участник '{player1}' не найден.")
        return False
    if player2 not in participants:
        print(f"Ошибка: участник '{player2}' не найден.")
        return False
    if player1 == player2:
        print("Ошибка: участник не может играть сам с собой.")
        return False
    return True

def record_result(player1, player2, winner):
    """Записывает результат матча. Победитель получает 2 очка, проигравший — 1 очко."""
    # Определяем, кто победитель и кто проигравший по факту
    if winner not in participants:
        print(f"Ошибка: победитель '{winner}' не зарегистрирован.")
        return
    
    if winner == 'draw':
        print("Ошибка: результат ничьей не предусмотрен в этой системе.")
        return

    # Находим проигравшего (это тот, кто не победитель, но участвовал в матче)
    loser = player2 if winner == player1 else player1

    # Обновляем статистику (увеличиваем, а не перезаписываем)
    participants[winner]['wins'] += 1
    participants[winner]['points'] += 2
    
    participants[loser]['losses'] += 1
    participants[loser]['points'] += 1
    
    print(f"Результат записан: {winner} победил {loser}.")

def get_leader():
    """Возвращает имя текущего лидера турнира (по очкам)."""
    if not participants:
        return None
    return max(participants, key=lambda p: participants[p]['points'])

def find_participant(name):
    """Ищет и выводит данные конкретного участника."""
    participant = participants.get(name)
    if participant:
        print(f"\nДанные участника '{name}':")
        print(f"  Дополнительная информация: {participant['info']}")
        print(f"  Победы: {participant['wins']}, Поражения: {participant['losses']}")
        print(f"  Очки: {participant['points']}")
    else:
        print(f"Участник '{name}' не найден.")

def print_standings():
    """Выводит полную турнирную таблицу."""
    if not participants:
        print("Турнир пуст. Нет зарегистрированных участников.")
        return
    
    print("\n" + "="*50)
    print("ТУРНИРНАЯ ТАБЛИЦА")
    print("="*50)
    print(f"{'Имя':<20} {'Инфо':<15} {'Очки':>6} {'Победы':>8} {'Поражения':>11}")
    print("-"*50)
    
    # Сортируем по очкам (убывание), чтобы лидер был сверху
    sorted_participants = sorted(
        participants.items(), 
        key=lambda item: item[1]['points'], 
        reverse=True
    )
    
    for name, data in sorted_participants:
        print(f"{name:<20} {data['info']:<15} {data['points']:>6} {data['wins']:>8} {data['losses']:>11}")
    
    print("="*50)

def main():
    print("Добро пожаловать в систему управления турниром!")
    
    while True:
        print("\n--- МЕНЮ ---")
        print("1. Зарегистрировать участника")
        print("2. Провести матч и записать результат")
        print("3. Найти участника")
        print("4. Показать турнирную таблицу")
        print("5. Определить лидера")
        print("0. Выход")
        
        choice = input("\пВыберите действие (0-5): ").strip()
        
        if choice == '0':
            print("До свидания!")
            break
        
        elif choice == '1':
            name = input("Введите имя участника: ").strip()
            if not name:
                print("Имя не может быть пустым.")
                continue
            info = input("Введите дополнительную информацию (например, клуб или город): ").strip()
            add_participant(name, info)
        
        elif choice == '2':
            name1 = input("Введите имя первого участника: ").strip()
            name2 = input("Введите имя второго участника: ").strip()
            
            if create_match(name1, name2):
                winner_name = input("Введите имя победителя: ").strip()
                # Дополнительная проверка: победитель должен быть одним из двух участников
                if winner_name not in (name1, name2):
                    print("Ошибка: победителем может быть только один из участников матча.")
                else:
                    record_result(name1, name2, winner_name)
        
        elif choice == '3':
            name = input("Введите имя участника для поиска: ").strip()
            find_participant(name)
        
        elif choice == '4':
            print_standings()
        
        elif choice == '5':
            leader = get_leader()
            if leader:
                print(f"Текущий лидер турнира: {leader} (очков: {participants[leader]['points']})")
            else:
                print("В турнире пока нет участников.")
        
        else:
            print("Неверный выбор. Пожалуйста, введите число от 0 до 5.")

if __name__ == "__main__":
    main()
